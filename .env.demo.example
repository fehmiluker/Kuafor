# ---------------------------------------------------------------------------
# DEMO / TEST SUNUCUSU (cPanel) şablonu — bu dosyada HİÇBİR gerçek şifre yok.
# Sunucuda:  cp .env.demo.example .env  ->  aşağıdaki <...> alanlarını doldurun
#            ->  php artisan key:generate
# Gerçek WhatsApp mesajı, gerçek ödeme ve gerçek e-posta bu ayarlarla KAPALI (SMS hiç kullanılmaz).
# ---------------------------------------------------------------------------
APP_NAME="Kuaför Randevu Demo"
# staging: demo verisi (DemoSeeder) yalnızca production DIŞINDA oluşturulur.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://<demo.alanadiniz.com>
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
APP_DISPLAY_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# cPanel > MySQL Databases bölümünde oluşturduğunuz bilgiler
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpanelkullanici_kuafor>
DB_USERNAME=<cpanelkullanici_kuafor>
DB_PASSWORD=<veritabani_sifresi>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# cPanel'de Redis olmadığı için veritabanı sürücüleri; kuyruk cron ile işlenir.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# E-posta GÖNDERİLMEZ, içerik storage/logs altındaki log dosyasına yazılır.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp: SANDBOX. Gerçek mesaj GİTMEZ. Meta anahtarlarını demo'da BOŞ bırakın.
WHATSAPP_PROVIDER_MODE=fake
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_PLATFORM_FALLBACK=true

# Telefon doğrulama kodları WhatsApp ile gider; demo'da (fake) gönderilmez, log dosyasına yazılır.

# Ödeme: müşteri ödemesi zaten yok. Abonelik ödeme bildirim adresi, secret BOŞ olduğu için kapalıdır.
SUBSCRIPTION_PAYMENT_PROVIDER=manual
# PayTR test mağazasıyla denemek için: SUBSCRIPTION_PAYMENT_PROVIDER=paytr, PAYTR_TEST_MODE=true
# ve PAYTR_MERCHANT_ID / PAYTR_MERCHANT_KEY / PAYTR_MERCHANT_SALT (test modunda gerçek para çekilmez).
SUBSCRIPTION_WEBHOOK_SECRET=

CORS_ALLOWED_ORIGINS=https://<demo.alanadiniz.com>
TRUSTED_PROXIES=127.0.0.1
