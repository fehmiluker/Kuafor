APP_NAME="Kuaför Randevu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
# Stored times are always UTC; this is the default display/branch timezone.
APP_DISPLAY_TIMEZONE=Europe/Istanbul
# APP_PREVIOUS_KEYS=   # for APP_KEY rotation

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kuafor
DB_USERNAME=kuafor
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# Local: database. Production: redis (QUEUE_CONNECTION=redis, CACHE_STORE=redis, SESSION_DRIVER=redis)
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="randevu@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp Business Platform (official Meta Cloud API). "fake" = sandbox, no real messages.
WHATSAPP_PROVIDER_MODE=fake
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
# Embedded Signup ("WhatsApp'ı bağla" button) configuration id from the Meta App Dashboard
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Salons without their own number send through the platform number (admin > Sistem)
WHATSAPP_PLATFORM_FALLBACK=true
# Provider fees for reporting only (from your Meta/BSP contract; not hardcoded)
WHATSAPP_PRICING_CURRENCY=USD
WHATSAPP_PRICE_UTILITY=
WHATSAPP_PRICE_MARKETING=
WHATSAPP_BSP_FEE=

# SMS provider for OTP: "log" writes to the log (development), "netgsm" sends real SMS
SMS_PROVIDER=log
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# true: Netgsm OTP endpoint (requires an OTP package)
NETGSM_OTP=false

# SaaS subscription payments (NOT customer appointments).
# "manual" = admin activation + signed internal webhook, "paytr" = owners pay by card (PayTR iFrame).
SUBSCRIPTION_PAYMENT_PROVIDER=manual
SUBSCRIPTION_WEBHOOK_SECRET=
# PayTR Bildirim URL: https://<domain>/webhooks/subscription-payments/paytr
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

CORS_ALLOWED_ORIGINS=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1

VITE_APP_NAME="${APP_NAME}"
